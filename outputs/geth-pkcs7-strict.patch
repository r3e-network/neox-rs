+func TestPKCS7UnPaddingStrict(t *testing.T) {
+	const blockSize = 16
+
+	for padding := 1; padding <= blockSize; padding++ {
+		t.Run("valid_padding_"+strconv.Itoa(padding), func(t *testing.T) {
+			payload := bytes.Repeat([]byte{0xa5}, blockSize-padding)
+			padded := append(payload, bytes.Repeat([]byte{byte(padding)}, padding)...)
+			result, err := pkcs7UnPadding(padded, blockSize)
+			require.NoError(t, err)
+			require.True(t, bytes.Equal(payload, result))
+		})
+	}
+
+	for _, tc := range []struct {
+		name string
+		data []byte
+	}{
+		{name: "zero", data: bytes.Repeat([]byte{0}, blockSize)},
+		{name: "oversized", data: bytes.Repeat([]byte{17}, blockSize)},
+		{name: "byte_255", data: bytes.Repeat([]byte{255}, blockSize)},
+		{name: "padding_exceeds_buffer", data: []byte{8, 8, 8, 8}},
+		{name: "empty", data: nil},
+		{name: "short_one_byte", data: []byte{1}},
+		{name: "short_two_bytes", data: []byte{2, 2}},
+		{name: "non_block_aligned", data: []byte("not-a-block")},
+		{name: "inconsistent_two_bytes", data: append(bytes.Repeat([]byte{0x42}, blockSize-2), 1, 2)},
+		{name: "inconsistent_sixteen_bytes", data: func() []byte {
+			data := bytes.Repeat([]byte{16}, blockSize)
+			data[0] = 15
+			return data
+		}()},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			_, err := pkcs7UnPadding(tc.data, blockSize)
+			require.Error(t, err)
+		})
+	}
+}
