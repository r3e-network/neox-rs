+++ b/params/config_pkcs7strict_test.go
@@ -0,0 +1,71 @@
+package params
+
+import (
+	"math/big"
+	"testing"
+)
+
+// pkcs7ForkOrderTestConfig builds a chain config whose non-optional forks
+// (homestead..london, shanghaiTime) are all enabled, mirroring the MainNet
+// shape: block-based forks up to London, then a timestamp fork, then the
+// block-based NeoX forks. CheckConfigForkOrder requires this.
+func pkcs7ForkOrderTestConfig(strict *big.Int) *ChainConfig {
+	zero := big.NewInt(0)
+	shanghai := uint64(0)
+	return &ChainConfig{
+		HomesteadBlock:       zero,
+		EIP150Block:          zero,
+		EIP155Block:          zero,
+		EIP158Block:          zero,
+		ByzantiumBlock:       zero,
+		ConstantinopleBlock:  zero,
+		PetersburgBlock:      zero,
+		IstanbulBlock:        zero,
+		BerlinBlock:          zero,
+		LondonBlock:          zero,
+		ShanghaiTime:         &shanghai,
+		NeoXDKGBlock:         big.NewInt(10),
+		NeoXAMEVBlock:        big.NewInt(20),
+		NeoXEthSigBlock:      big.NewInt(30),
+		NeoXPkcs7StrictBlock: strict,
+	}
+}
+
+// TestIsNeoXPkcs7Strict mirrors the Rust side assertions in
+// crates/neox/chainspec/src/spec.rs (is_pkcs7_strict_active_at_block):
+// the fork activates iff block_height >= neoXPkcs7StrictBlock, and a chain
+// that omits the field stays legacy forever.
+func TestIsNeoXPkcs7Strict(t *testing.T) {
+	// nil => never active (legacy forever), matching Rust Option::None semantics.
+	c := &ChainConfig{}
+	if c.IsNeoXPkcs7Strict(big.NewInt(0)) || c.IsNeoXPkcs7Strict(big.NewInt(1_000_000)) {
+		t.Fatal("nil fork block must never activate strict unpadding")
+	}
+
+	// Boundary semantics must match Rust: active iff num >= block.
+	c = &ChainConfig{NeoXPkcs7StrictBlock: big.NewInt(50)}
+	if c.IsNeoXPkcs7Strict(big.NewInt(49)) {
+		t.Fatal("height 49 must stay legacy when fork block is 50")
+	}
+	if !c.IsNeoXPkcs7Strict(big.NewInt(50)) || !c.IsNeoXPkcs7Strict(big.NewInt(100)) {
+		t.Fatal("height >= fork block must activate strict unpadding")
+	}
+
+	// Zero means already activated at genesis.
+	c = &ChainConfig{NeoXPkcs7StrictBlock: big.NewInt(0)}
+	if !c.IsNeoXPkcs7Strict(big.NewInt(0)) {
+		t.Fatal("fork block 0 must be active from genesis")
+	}
+}
+
+// TestCheckConfigForkOrderNeoXPkcs7Strict ensures the new fork participates in
+// fork-order validation, mirroring the other block-based NeoX forks.
+func TestCheckConfigForkOrderNeoXPkcs7Strict(t *testing.T) {
+	if err := pkcs7ForkOrderTestConfig(big.NewInt(40)).CheckConfigForkOrder(); err != nil {
+		t.Fatalf("ordered fork config rejected: %v", err)
+	}
+
+	if err := pkcs7ForkOrderTestConfig(big.NewInt(5)).CheckConfigForkOrder(); err == nil {
+		t.Fatal("out-of-order neoXPkcs7StrictBlock must be rejected")
+	}
+}
