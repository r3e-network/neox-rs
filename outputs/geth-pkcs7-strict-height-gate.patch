@@ -26,6 +28,65 @@ func TestRecover(t *testing.T) {
 	}
 }
 
+func TestPKCS7UnPaddingModes(t *testing.T) {
+	const blockSize = 16
+
+	// Valid padding 1..=blockSize must succeed in BOTH modes with the same result.
+	for padding := 1; padding <= blockSize; padding++ {
+		t.Run("valid_padding_"+strconv.Itoa(padding), func(t *testing.T) {
+			payload := bytes.Repeat([]byte{0xa5}, blockSize-padding)
+			padded := append(payload, bytes.Repeat([]byte{byte(padding)}, padding)...)
+			legacy, err := pkcs7UnPadding(padded, blockSize, false)
+			require.NoError(t, err)
+			strict, err := pkcs7UnPadding(padded, blockSize, true)
+			require.NoError(t, err)
+			require.True(t, bytes.Equal(payload, legacy))
+			require.True(t, bytes.Equal(payload, strict))
+		})
+	}
+
+	for _, tc := range []struct {
+		name          string
+		data          []byte
+		legacyOK      bool
+		legacyKeepLen int
+	}{
+		// pad == 0: legacy truncates nothing and returns the input unchanged.
+		{name: "zero", data: bytes.Repeat([]byte{0}, blockSize), legacyOK: true, legacyKeepLen: blockSize},
+		// pad == 17 with a 32-byte buffer: legacy truncates 17 bytes, strict rejects.
+		{name: "oversized", data: bytes.Repeat([]byte{17}, 2*blockSize), legacyOK: true, legacyKeepLen: 2*blockSize - 17},
+		// pad == 255 with a 16-byte buffer: len - pad < 0 in both modes.
+		{name: "byte_255", data: bytes.Repeat([]byte{255}, blockSize)},
+		// Non-block-aligned and empty inputs are rejected by the shared guard.
+		{name: "padding_exceeds_buffer", data: []byte{8, 8, 8, 8}},
+		{name: "empty", data: nil},
+		{name: "short_one_byte", data: []byte{1}},
+		{name: "short_two_bytes", data: []byte{2, 2}},
+		{name: "non_block_aligned", data: []byte("not-a-block")},
+		// Inconsistent padding bytes: legacy accepts (historical behaviour), strict rejects.
+		{name: "inconsistent_two_bytes", data: append(bytes.Repeat([]byte{0x42}, blockSize-2), 1, 2), legacyOK: true, legacyKeepLen: blockSize - 2},
+		{name: "inconsistent_sixteen_bytes", data: func() []byte {
+			data := bytes.Repeat([]byte{16}, blockSize)
+			data[0] = 15
+			return data
+		}(), legacyOK: true, legacyKeepLen: 0},
+	} {
+		t.Run(tc.name+"_legacy", func(t *testing.T) {
+			result, err := pkcs7UnPadding(tc.data, blockSize, false)
+			if tc.legacyOK {
+				require.NoError(t, err)
+				require.Len(t, result, tc.legacyKeepLen)
+			} else {
+				require.Error(t, err)
+			}
+		})
+		t.Run(tc.name+"_strict", func(t *testing.T) {
+			_, err := pkcs7UnPadding(tc.data, blockSize, true)
+			require.Error(t, err)
+		})
+	}
+}
